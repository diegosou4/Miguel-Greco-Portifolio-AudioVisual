  "narrative": {
    "northStar": "Cinematic Editorial",
    "overview": "Large real films, expressive typography and quiet navigation establish a professional portfolio with the rhythm of a director's treatment. Images carry the atmosphere; the interface makes the work, contribution and next action clear.\n\nThe user-confirmed rebrand uses a neutral dark screening-room foundation inspired by lolawilde.com, with light lavender heading emphasis, a scroll-revealed biography trail and restrained interface details. Manrope supplies both confident titles and clear reading text. Depth comes from real media and the circular perspective carousel, with an equally complete reduced-motion presentation. The home-page sequence is recorded in `.impeccable/surfaces/home.md`.",
    "keyCharacteristics": [
      "Real moving images as the visual lead.",
      "Large, tightly tracked editorial headings.",
      "Neutral dark surfaces with off-white text, light lavender heading emphasis and restrained accents.",
      "Rounded film frames arranged in circular perspective.",
      "Visible controls, keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Film First Rule",
        "body": "Let the source film supply its own color; use interface color to make structure and actions legible.",
        "section": "colors"
      },
      {
        "name": "The Accent Restraint Rule",
        "body": "Use light lavender for selected heading words, small details and interaction states; preserve neutral dark backgrounds across large sections.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Create hierarchy through scale, weight, spacing and placement within Manrope.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do lead with real films and preserve project titles, participation and complete source credits.",
      "Do use Manrope hierarchy, neutral dark surfaces, light lavender heading emphasis and restrained interface details.",
      "Do preserve visible controls, keyboard focus, mobile touch targets and reduced-motion behavior.",
      "Do keep the large opening video and the circular perspective gallery."
    ],
    "donts": [
      "Don't turn the contact area or other large sections into purple fills.",
      "Don't flatten the selected circular carousel into a plain horizontal strip.",
      "Don't replace the opening film with a decorative placeholder or enable autoplay sound.",
      "Don't assume a variable font axis exists in the supplied static assets."
    ]
  }
