  "narrative": {
    "northStar": "Cinematic Editorial",
    "overview": "Large real films, expressive typography and quiet navigation establish a professional portfolio with the rhythm of a director's treatment. Images carry the atmosphere; the interface makes the work, contribution and next action clear.\n\nThe confirmed world combines charcoal, warm paper and chartreuse with asymmetric, unboxed media. Manrope supplies both confident titles and restrained reading text. Motion follows the film and visitor interaction, with an equally complete reduced-motion presentation. The home-page sequence is recorded in `.impeccable/surfaces/home.md`.",
    "keyCharacteristics": [
      "Real moving images as the visual lead.",
      "Large, tightly tracked editorial headings.",
      "Asymmetric media with captions outside the frame.",
      "Flat surfaces, thin rules and selective chartreuse.",
      "Visible controls, keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Film First Rule",
        "body": "Let the source film supply its own color; use interface color to make structure and actions legible.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Create hierarchy through scale, weight, spacing and placement within Manrope.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do lead with real films and keep titles and participation readable beside the media.",
      "Do use Manrope hierarchy, warm neutrals and chartreuse consistently.",
      "Do preserve visible labels, focus states, mobile touch targets and reduced-motion behavior.",
      "Do use thin rules and space to separate content."
    ],
    "donts": [
      "Don't add raised card shells around the film grid.",
      "Don't replace the opening film with a decorative placeholder or enable autoplay sound.",
      "Don't treat small secondary credits as the default size for primary labels.",
      "Don't assume a variable font axis exists in the supplied static assets."
    ]
  }
